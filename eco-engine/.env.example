# Copy to .env (never commit .env) and fill in the values you use.

# --- Database ---------------------------------------------------------------
# Local default is SQLite (eco_engine.db) when unset.
# Docker Compose: set a unique password. The database is private to the Compose network.
POSTGRES_PASSWORD=
# For Supabase Postgres, copy the exact Session pooler URL from Dashboard -> Connect.
# The REST URL below cannot be used as DATABASE_URL. URL-encode reserved password characters.
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Sign-in ---------------------------------------------------------------
# Required for local accounts in Docker/production; use one random 32+ character
# value and keep it stable across restarts. Local development creates .auth_secret.
ECO_AUTH_SECRET=
# Optional Supabase Auth. Use the project root (without /rest/v1/) and the
# publishable key from Dashboard -> Connect or Settings -> API Keys.
# Never use a secret or service_role key in the browser.
# SUPABASE_URL=https://tajtlvwdgdkrxisuqyrm.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_ANON_KEY=<legacy-anon-key>  # legacy fallback only

# --- Optional: LLM-worded advisor explanations ------------------------------
# Pick one provider (auto-detected from the first key found if ECO_LLM_PROVIDER is unset).
# ECO_LLM_PROVIDER=gemini            # anthropic | gemini | ollama | none
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
# OLLAMA_HOST=http://localhost:11434 # Docker: http://host.docker.internal:11434
# ECO_LLM_MODEL=                     # defaults: claude-opus-5-5 | gemini-2.5-flash | gemma4
# ECO_LLM_TIMEOUT_S=                 # default 8 (60 for Ollama)
